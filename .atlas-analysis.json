  "keyFeatures": [
    "Byte-exact matching decompilation targeting PAL retail v1.03 (SLES_503.86)",
    "Dual-compiler toolchain: SN ProDG EE GCC 2.95.2-EE for game TUs, EE GCC 2.9-ee-991111-01 for Sony runtime",
    "Full symbol registries extracted from the retail .mdebug ECOFF debug section (3,751 functions, 3,750 data symbols)",
    "Hybrid object system: splices verified C with retail assembly slices per function state",
    "MCP server for AI-assisted decompilation (Claude Code, Codex, and any MCP client)",
    "Canonical byte-verification pipeline: promote.py is the sole writer of state=matching",
    "objdiff integration with decomp.dev progress reporting",
    "Fork-safe CI using a private container image that holds game files",
    "Shared cross-client sessions supporting hand-off between AI agents",
    "Cooperative decompilation backlog targeting multiplayer/modding use cases"
  ],
  "publicApiSurface": [
    "python decomp.py toolchain",
    "python decomp.py setup",
    "python decomp.py src/<group>/<unit>.c",
    "python tools/promote.py",
    "python tools/promote.py --init src/<group>/<unit>.c",
    "python tools/promote.py --init-data src/<unit>.c",
    "python tools/promote.py --complete <unit-id>",
    "python tools/status.py --check",
    "python tools/verify_target.py",
    "python tools/extract_mdebug.py [--check]",
    "python tools/extract_data_symbols.py [--check]",
    "python tools/extract_data_map.py [--check]",
    "python configure.py [--check|--strict]",
    "python tools/dispatch.py ninja <target>",
    "python tools/setup_toolchain.py --download",
    "python tools/fingerprint_compiler.py [--all]",
    "python tools/check_types.py [--check]",
    "python tools/check_codegen.py --build --snapshot|--compare",
    "python tools/dump_data.py <data-id>",
    "python -m tools.decomp_agent.cli health",
    "python -m tools.decomp_agent.cli candidates",
    "python -m tools.decomp_agent.cli context <id>",
    "python -m tools.decomp_agent.cli compile-diff <id>",
    "python -m tools.decomp_agent.cli verify <id>",
    "python -m tools.decomp_mcp.server --repo <path>"
  ]
